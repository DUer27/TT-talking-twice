# ===================================================
# Docker Compose 部署环境变量配置模板
# 复制为 .env 或直接在系统环境变量中使用
# ===================================================

# 外部访问端口 (宿主机暴露端口)
PORT=6999

# 宿主机 MySQL 访问端口（如无需对外暴露可保持默认）
HOST_DB_PORT=3306

# MySQL 数据库配置
DB_NAME=tt_talking_twice
DB_USER=tt_app
DB_PASSWORD=tt_talking_twice_pass_2026
MYSQL_ROOT_PASSWORD=root_strong_password_2026

# 初始管理员账号配置 (首次启动自动创建，密码至少 12 位)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=AdminStrong#2026
DEFAULT_ADMIN_NICKNAME=管理员

# 邮箱验证码加密盐（请务必修改为随机长字符串）
VERIFICATION_CODE_SECRET=replace_with_a_very_long_secure_secret_string_for_docker

# SMTP 邮件发送配置 (选填，不配置不影响核心功能，仅验证码不发真实邮件)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# AI 阅卷与诊断配置 (选填)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
